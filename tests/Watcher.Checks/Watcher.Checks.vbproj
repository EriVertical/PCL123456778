<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <RootNamespace>PCL</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Plain Craft Launcher 2/Modules/Minecraft/ModWatcher.vb" Link="ModWatcher.vb" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Collections.Concurrent" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.Linq" />
    <Import Include="System.Text" />
    <Import Include="System.Threading" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
